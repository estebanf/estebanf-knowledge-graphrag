    {
      "id": "concepts_stage_failure_rate_threshold",
      "label": "Stage Failure-Rate Threshold",
      "file_type": "rationale",
      "source_file": "/Users/estebanf/development/knowledge-graphrag/CONCEPTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Extraction failures are recorded rather than silently dropped. Stage completes if failure rate stays at or below configured threshold; fails outright above it. This prevents silently missing entities or insights."
    },
    {
      "id": "concepts_stage_duration_baseline",
      "label": "Stage Duration Baseline",
      "file_type": "rationale",
      "source_file": "/Users/estebanf/development/knowledge-graphrag/CONCEPTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Frozen, explicitly-snapshotted reference duration — NOT a moving average. A moving baseline rises with a gradual regression and would never register drift. Only updated when someone explicitly re-snapshots it."
    },
    {
      "id": "concepts_weekly_maintenance_sweep",
      "label": "Weekly Maintenance Sweep",
      "file_type": "concept",
      "source_file": "/Users/estebanf/development/knowledge-graphrag/CONCEPTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Insight-merge scoped to recently-created insights by default — full-corpus sweep is opt-in, not routine. Merging duplicate entities, removing orphans, reconciling Postgres/Memgraph, refreshing stats. Dry-run by default; --execute applies changes and refuses while intake is active."
    },
    {
      "id": "concepts_schema_reconciliation",
      "label": "Schema Reconciliation",
      "file_type": "concept",
      "source_file": "/Users/estebanf/development/knowledge-graphrag/CONCEPTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "concepts_community_run",
      "label": "Community Run",
      "file_type": "concept",
      "source_file": "/Users/estebanf/development/knowledge-graphrag/CONCEPTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Persisted in its own community_runs table — not the ingestion jobs table — because the jobs table is ingestion-shaped (source_id, ingestion stages). Every execution, sync or async, creates a run row with stable per-run community ids."
    },
    {
      "id": "concepts_virtual_entity_resolution",
      "label": "Virtual Entity Resolution",
      "file_type": "concept",
      "source_file": "/Users/estebanf/development/knowledge-graphrag/CONCEPTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Run-local clustering of near-duplicate entities by embedding similarity. Merged entities collapse for that run only; nothing in stored entities or Memgraph is mutated. Stored data is never mutated by a community run."
    },
    {
      "id": "concepts_cross_source_edge_cache",
      "label": "Cross-Source Edge Cache",
      "file_type": "concept",
      "source_file": "/Users/estebanf/development/knowledge-graphrag/CONCEPTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Persisted entity-pair similarity edges keyed on persistent entity ids, computed JIT and reused across runs. Derived data — safe to truncate. Invalidated by the weekly maintenance sweep when entities are merged."
    },
    {
      "id": "concepts_working_set",
      "label": "Working Set",
      "file_type": "concept",
      "source_file": "/Users/estebanf/development/knowledge-graphrag/CONCEPTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Scope resolution snapshots member ids at dispatch; later edits never change in-flight or completed runs. Global (no owner column) — single-user system, Principal ownership is deferred."
    },
