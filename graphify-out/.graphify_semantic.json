    {
      "id": "concepts_binary_quantized_hnsw",
      "label": "Binary-Quantized HNSW",
      "file_type": "concept",
      "source_file": "/Users/estebanf/development/knowledge-graphrag/CONCEPTS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Required because entities.embedding is vector(4096) and pgvector HNSW caps at 2000 dims — a plain vector index is impossible. Embeddings are converted to binary form for HNSW candidate lookup, then original vectors rerank."
    },
